{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "rootDir": "./",
    "outDir": "./build/",
    "noImplicitAny": true,
    "module": "nodenext",
    "target": "es6",
    "jsx": "react",
    "allowJs": true,
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}